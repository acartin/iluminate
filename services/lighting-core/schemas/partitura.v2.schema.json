{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iluminate.local/schemas/partitura.v2.schema.json",
  "title": "Iluminate Partitura v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "sourceChecksum", "requiredCoreVersion", "defaultScene", "outputs", "pixelMap", "zones", "groups", "scenes"],
  "properties": {
    "schemaVersion": { "const": "partitura.v2" },
    "projectId": { "$ref": "#/$defs/id" },
    "sourceChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "requiredCoreVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "defaultScene": { "$ref": "#/$defs/id" },
    "outputs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "output", "pixelCount"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "output": { "enum": [1, 2, 3] },
          "pixelCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "pixelMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "id", "output", "serialIndex", "stringId", "routeOffsetCm", "x", "y", "tangentDeg", "normalizedX", "normalizedY"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "id": { "$ref": "#/$defs/id" },
          "output": { "enum": [1, 2, 3] },
          "serialIndex": { "type": "integer", "minimum": 0 },
          "stringId": { "type": "string", "minLength": 1 },
          "routeOffsetCm": { "type": "number", "minimum": 0 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "tangentDeg": { "type": "number" },
          "normalizedX": { "type": "number", "minimum": 0, "maximum": 1 },
          "normalizedY": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "zones": { "$ref": "#/$defs/targets" },
    "groups": { "$ref": "#/$defs/targets" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
    "target": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "installation" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "enum": ["zone", "group"] }, "id": { "$ref": "#/$defs/id" } } }
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "pixelIndices"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "pixelIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "loop", "durationMs", "tracks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "loop": { "type": "boolean" },
        "durationMs": { "type": "integer", "minimum": 1 },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "target", "clips"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/target" },
        "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "coordinateSpace", "startMs", "durationMs", "layer", "blend", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "effect": { "enum": ["off", "solid", "fade", "pulse", "chase", "comet", "wipe", "toggle", "flame", "spatial_fill", "spatial_wave", "aurora"] },
        "target": { "$ref": "#/$defs/target" },
        "coordinateSpace": { "enum": ["serial", "local", "global"] },
        "startMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 1 },
        "layer": { "type": "integer" },
        "blend": { "enum": ["replace", "add", "max", "multiply", "alpha", "mask"] },
        "params": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": ["string", "number", "boolean", "null"] },
              { "type": "array", "items": { "type": "string" } },
              { "type": "array", "items": { "type": "number" } }
            ]
          }
        },
        "repeat": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "forever" }] },
        "markers": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    }
  }
}
