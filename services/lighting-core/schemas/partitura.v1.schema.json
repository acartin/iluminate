{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iluminate.local/schemas/partitura.v1.schema.json",
  "title": "Iluminate Partitura v1",
  "type": "object",
  "required": ["schemaVersion", "projectId", "requiredCoreVersion", "defaultScene", "chains", "segments", "pixelMap", "zones", "scenes"],
  "properties": {
    "schemaVersion": { "const": "partitura.v1" },
    "projectId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
    "requiredCoreVersion": { "type": "string" },
    "defaultScene": { "type": "string" },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "output", "pixelCount", "direction"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "output": { "enum": [1, 2, 3] },
          "pixelCount": { "type": "integer", "minimum": 0 },
          "direction": { "enum": ["forward", "reverse"] }
        }
      }
    },
    "segments": { "type": "array", "minItems": 1 },
    "pixelMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "chainId", "output", "index", "x", "y", "order"],
        "properties": {
          "id": { "type": "string" },
          "chainId": { "type": "string" },
          "output": { "enum": [1, 2, 3] },
          "index": { "type": "integer", "minimum": 0 },
          "segmentId": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "zones": { "type": "array", "minItems": 1 },
    "scenes": { "type": "array", "minItems": 1 },
    "metadata": { "type": "object" }
  }
}
